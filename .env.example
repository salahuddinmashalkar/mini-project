# ========================================================
# AeroCast Weather Dashboard - Environment Configuration
# ========================================================
# Copy this file to .env and fill in your actual credentials.
# Note: NEVER commit your actual .env file to Git!

# Groq API Key (for LLM Meteorological Analysis)
# Obtain your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: OpenWeatherMap API Key (if you wish to use OpenWeatherMap)
OPENWEATHER_API_KEY=

# Application Server Port (Default is 8080)
PORT=8080

# Default Startup Location
AEROCAST_DEFAULT_CITY=Tokyo
AEROCAST_DEFAULT_COUNTRY=Japan

# Default Unit System: METRIC (°C, km/h) or IMPERIAL (°F, mph)
AEROCAST_DEFAULT_UNIT=METRIC
